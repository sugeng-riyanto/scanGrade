<!DOCTYPE html>
<html lang="id" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ScanGrade{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="https://unpkg.com/alpinejs@3.14.8" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        * { font-family: 'Nunito', system-ui, sans-serif; }
    </style>
    {% block head_extra %}{% endblock %}
</head>
<body class="h-full bg-gradient-to-br from-orange-50 via-stone-50 to-amber-50" data-exam-id="{{ exam.id if exam else '' }}">
    <div x-data="{ sidebarOpen: false }" class="min-h-full">
        {% if g.user_id %}
        <nav class="bg-gradient-to-r from-orange-600 via-orange-500 to-amber-500 text-white shadow-lg shadow-orange-200/50">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="flex h-16 items-center justify-between">
                    <div class="flex items-center">
                        <button @click="sidebarOpen = !sidebarOpen" class="lg:hidden mr-2">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                        <a href="{{ url_for('teacher.dashboard') }}" class="text-xl font-extrabold tracking-tight">
                            <i class="fas fa-graduation-cap mr-2"></i>ScanGrade
                        </a>
                    <div class="hidden lg:ml-10 lg:flex lg:space-x-2">
                        {% if g.user_role == 'admin' %}
                        <a href="{{ url_for('admin.dashboard') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-home mr-1"></i>Dashboard
                        </a>
                        <a href="{{ url_for('admin.users') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-users mr-1"></i>Users
                        </a>
                        {% elif g.user_role == 'teacher' %}
                        <a href="{{ url_for('teacher.dashboard') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-home mr-1"></i>Dashboard
                        </a>
                        <a href="{{ url_for('teacher.exam_form') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-plus mr-1"></i>Buat Exam
                        </a>
                        <a href="{{ url_for('teacher.scan_page') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-camera mr-1"></i>Scan
                        </a>
                        <a href="{{ url_for('teacher.results') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-chart-bar mr-1"></i>Results
                        </a>
                        {% elif g.user_role == 'student' %}
                        <a href="{{ url_for('student.exam_list') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-home mr-1"></i>Ujian
                        </a>
                        <a href="{{ url_for('student.results') }}" class="px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                            <i class="fas fa-chart-bar mr-1"></i>Hasil
                        </a>
                        {% endif %}
                    </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <span class="text-sm hidden sm:block font-medium opacity-80">{{ g.user_id[:8] }}...</span>
                        <a href="{{ url_for('auth.logout') }}" class="text-sm font-semibold bg-white/15 px-3 py-1.5 rounded-xl hover:bg-white/25 transition">
                            <i class="fas fa-sign-out-alt mr-1"></i>Logout
                        </a>
                    </div>
                </div>
            </div>
            <div x-show="sidebarOpen" class="lg:hidden border-t border-white/20">
                <div class="space-y-1 px-4 py-3">
                    {% if g.user_role == 'admin' %}
                    <a href="{{ url_for('admin.dashboard') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-home mr-2"></i>Dashboard
                    </a>
                    <a href="{{ url_for('admin.users') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-users mr-2"></i>Users
                    </a>
                    {% elif g.user_role == 'teacher' %}
                    <a href="{{ url_for('teacher.dashboard') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-home mr-2"></i>Dashboard
                    </a>
                    <a href="{{ url_for('teacher.exam_form') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-plus mr-2"></i>Buat Exam
                    </a>
                    <a href="{{ url_for('teacher.scan_page') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-camera mr-2"></i>Scan
                    </a>
                    <a href="{{ url_for('teacher.results') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-chart-bar mr-2"></i>Results
                    </a>
                    {% elif g.user_role == 'student' %}
                    <a href="{{ url_for('student.exam_list') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-home mr-2"></i>Ujian
                    </a>
                    <a href="{{ url_for('student.results') }}" class="block px-3 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 transition">
                        <i class="fas fa-chart-bar mr-2"></i>Hasil
                    </a>
                    {% endif %}
                </div>
            </div>
        </nav>
        {% endif %}

        <main>
            <div class="mx-auto max-w-7xl px-3 py-5 sm:px-6 lg:px-8">
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>

    {% block modals %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
