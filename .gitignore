references/
# Third-party product screenshots kept as a UX reference (ZipGrade). They are not
# ours to publish, and a reference image in the tree is one `git add -A` away from
# shipping inside the app's own repository.
docs/ref/
.opencode/
.aider*
# Other agents' state directories, ignored for the same reason as the two above: a
# checkout that carries their scratch is a checkout where `git add -A` ships somebody
# else's session.
.chatgpt/
.commandcode/

/static/
!/static/.gitkeep
node_modules/
# Committed on purpose. `npm ci` in `.github/workflows/unit-tests.yml` installs from
# this file, and two suites skip without the packages it pins — the essay editor's
# jsdom cases and the stylesheet-freshness comparison — so a job with no lockfile
# would be green about checks nobody ran. It is also what pins the tailwind build
# the committed `app/static/css/tailwind.css` is compared against.
app/static/css/input.css

# Load test artifacts
loadtest*.csv
# VPS terminal-proxy credentials (moved out of .env)
.env.vps-credentials

# Test artifacts
cookies*.txt
csrf*.txt
.freebuff/

# One-off local deploy/debug scripts (may contain VPS credentials — never commit)
/deploy_*.py
/fix_*.py
/debug_*.py
/check_*.py
/capture_*.py
/force_*.py
/hard_*.py
