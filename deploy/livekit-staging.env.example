# ─── ScanMeet staging — a template, not a working file ──────────────────────
#
# Every key the gate requires is here, and every value is a placeholder on
# purpose: copied unchanged this file FAILS `deploy/scanmeet_staging_gate.py`
# rather than looking like a configured pilot. Fill it on the staging host, at a
# private path outside this checkout:
#
#   mkdir -p ~/.config/scanmeet && chmod 700 ~/.config/scanmeet
#   umask 077
#   cp deploy/livekit-staging.env.example ~/.config/scanmeet/staging.env
#   nano ~/.config/scanmeet/staging.env          # replace every placeholder
#   chmod 600 ~/.config/scanmeet/staging.env
#
# Then, before anything is installed or started:
#
#   python -m deploy.scanmeet_staging_gate --env ~/.config/scanmeet/staging.env
#
# It prints one `FAIL: <KEY> …` line per value still missing, placeholder or
# pointing at production, and it never prints a value. `docs/SCANMEET_BIZNET_STAGING.md`
# says where each value comes from and how to prove it is not production's.
# Never commit a filled copy, and never paste a value into an issue or a chat.

# Which deployment this is. `true` is the declaration that the rest of this file
# describes a pilot; production does not set it and leaves the two flags below
# OFF.
SCANMEET_STAGING=true

# Public HTTPS origin of the staging app — no path, no credentials.
# It must NOT be scangrade.web.id, its `www.`/`lmsshb.` names, or any subdomain
# of that domain: every name under it reaches the production box.
SCANMEET_STAGING_URL=https://staging.your-school-domain.com

# Deployment-level kill switches. They ship **OFF** on purpose: this file is a
# template, and a copy that lands in a production `.env` by mistake must not
# switch Live on. A pilot sets both to `true` on the staging host — the staging
# gate refuses any other value — and the per-exam switch
# (`exams.scan_live_enabled`, migration 071) can then only narrow that, never
# widen it. `deploy/livekit_preflight.py` runs this template in CI and fails if
# it ever ships enabled.
SCANGRADE_LIVE_ENABLED=false
SCANGRADE_LIVE_EXAM_ENABLED=false

# LiveKit Cloud project: a *separate* project from production's.
# LIVEKIT_URL is the browser signaling endpoint from the project's Settings page
# (wss://<project>.livekit.cloud). The key and secret come from the same
# project's Keys page and are used server-side only; the secret is shown once.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Supabase project: a separate project from production's. SUPABASE_URL is
# https://<project-ref>.supabase.co from Settings → API; the gate refuses the
# production ref, and refuses a placeholder project ref, because a copied
# template would otherwise read as an isolated database.
# Both keys come from the same page and belong to that staging project only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me

# Signs the staging session cookie. Generate it on the staging host, never reuse
# production's:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-me
