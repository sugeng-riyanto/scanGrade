#!/usr/bin/env bash
# ─── ScanGrade pre-commit — credential scan, then the theme gate ─────────────
#
# Two checks, and the order is a decision: `deploy/secret_scan.py` runs on every
# commit and on every staged path, while the theme gate below runs only when the
# staged paths match its filter. A credential is the one defect that cannot be
# fixed by a later commit — it is in the history the moment it is pushed — so it
# is the one check that does not get to depend on which file was edited.
#
# Not installed by default: a hook lives in .git/, which is not committed, so
# every clone has to opt in once with
#
#     bash deploy/install-git-hooks.sh
#
# The same check is a hard gate in the VPS auto-deploy, so this is the early
# warning rather than the only defence: it fails the commit instead of the
# release.
#
# The gate runs only when a template or the stylesheet changed, so the common
# commit does not pay for it. `git commit --no-verify` skips both, which is Git's own
# escape hatch and is deliberate — a second, private bypass flag would be the
# thing that quietly stops this from ever running.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO" || exit 0

# What is actually being committed, not what happens to be on disk.
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

# ── The credential scan, on every commit and before the filter ───────────────
#
# Above the filter on purpose, and that is the whole point of it. A fixture
# written as `scheme://someone:<password>@db.example.edu` went up in a pull request
# and GitHub's own scanner failed the check there — after the branch existed, and
# after the literal was in a commit that could only be cleaned out of the history
# with a force-push. The theme gate below could not have caught it either: its
# filter watches templates, stylesheets, Python under `app/`, SQL and `deploy/`,
# and the offending commit touched one file under `tests/`.
#
# So this call takes no path filter at all. `deploy/secret_scan.py` reads the
# index itself — what this commit will contain, not what is on disk — and exits 1
# on a credential-shaped literal, printing the line with the value redacted. It is
# a couple of hundred milliseconds over the staged files, which is the price of
# not being the second place a secret leaks.
#
# The interpreter is looked for the way the gate looks for it, for the same
# measured reason: Windows ships an executable App Execution Alias for python3
# that prints "Python was not found" instead of running anything, so a candidate
# has to answer before it is trusted.
PY=""
for candidate in "$REPO/.venv/bin/python" "$REPO/.venv/Scripts/python.exe" python3 python; do
  case "$candidate" in
    */*) path="$candidate" ;;
    *) path=$(command -v "$candidate" 2>/dev/null) || continue ;;
  esac
  [ -n "$path" ] && [ -x "$path" ] || continue
  if "$path" -c 'import sys' >/dev/null 2>&1; then PY="$path"; break; fi
done
if [ -z "$PY" ]; then
  # Refused rather than skipped: a check that declines to run is indistinguish-
  # able from one that ran and found nothing, and the next commit would trust it.
  echo "pre-commit: the credential scan COULD NOT RUN — no working python interpreter." >&2
  echo "            Install Python 3.12 or create .venv in this checkout:" >&2
  echo "                python -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  echo "            Refusing the commit: a scan that did not run is not a clean scan." >&2
  exit 1
fi
if ! "$PY" "$REPO/deploy/secret_scan.py" --staged; then
  echo >&2
  echo "Commit blocked. Take the literal out of the file, or say on that line why it" >&2
  echo "is a fixture (\`secret-scan:allow <reason>\`). If it is a real credential it is" >&2
  echo "already in the history you are about to push: rotate it — see" >&2
  echo "docs/SECRET_ROTATION.md. To skip this once: git commit --no-verify" >&2
  exit 1
fi

# tailwind.config.js and package.json are in this list because they change what
# the stylesheet build produces: a colour changed in the config, or a flag added
# to `css:build`, leaves the committed tailwind.css stale exactly the way a new
# template class does. The gate is only worth running when its subject moved.
#
# The SQL and the Python are in it for the schema contract, which answers two
# different questions from the same two directories: a `select` naming a column no
# file creates (PostgREST refuses it, the page renders empty) and a policy any
# caller can satisfy without a session (the anon key is public, so `USING (true)`
# on `exams` handed out answer keys). A commit that touches neither is judged by
# neither.
#
# `deploy/` is in it whole — every shell script and every Python file — because
# the check now includes the committed-secret scan, and the key that scan exists
# to catch was committed in `deploy/bootstrap.sh`. A filter that watched only the
# contract file there would have let the very commit that leaked a service-role
# key through the hook that was meant to warn about it.
# Markdown and PowerShell are in it for the region guard, and for the same reason:
# the typo it exists for shipped in `AGENTS.md`, was copied into a merge runbook and
# into the Windows dev script, and none of those three would have triggered a filter
# that only watched templates, stylesheets, Python, SQL and `deploy/`. A documentation
# edit is a release of the record as much as a template edit is a release of a page.
# `.github/` is here for the workflow guard: a job that stops running the suite is
# invisible — it goes green by never starting — so the commit that edits a workflow
# is exactly the commit that has to judge it.
if ! printf '%s\n' "$CHANGED" | grep -qE '^app/templates/.*\.html$|^app/static/css/|^tailwind\.config\.js$|^package\.json$|^app/.*\.py$|^supabase/.*\.sql$|^deploy/.*\.(sh|py)$|^\.github/.*\.ya?ml$|^.*\.md$|^.*\.ps1$'; then
  exit 0
fi

# The check reads the working tree, so a partially staged file is judged by what
# is on disk rather than by the hunk in the index. Staging the whole file — which
# is what `git add <file>` and every editor integration does — makes the two the
# same. Splitting a file across commits is the one case where this can disagree,
# and it errs toward blocking, never toward letting unreadable text through.
echo "theme gate: template or stylesheet changes staged — checking readability, class names and the cached stylesheet…"

# Git exports its own repository-selection variables to this hook. Measured: a
# linked worktree hands the hook an ABSOLUTE `GIT_DIR` and `GIT_INDEX_FILE`
# (`…/.git/worktrees/<name>/index`), and a plain checkout at least sets
# `GIT_INDEX_FILE`. Every `git` the gate spawns then inherits them and resolves
# THAT repository instead of the scratch one in its own working directory — so
# `test_static_tree`'s `git add` wrote its fixtures into this checkout's index,
# and the tree it had just dirtied failed the very gate that ran it. Clear them
# for the gate and everything it spawns; the gate's own `git` calls rediscover
# this checkout from their cwd, which is the same index.
#
# This sits after the `git diff --cached` above on purpose: that line reads the
# index git handed us, and is the one place the hook's own view must be kept.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
if ! bash "$REPO/deploy/theme_gate.sh"; then
  echo
  # Not "fix the contrast": the gate refuses more than one thing (an unreadable
  # colour, a class name built at render time, a stale stylesheet, a language the
  # page does not declare, and — exit 3 — a commit that removed a check itself).
  # Naming one cause here sends the author to the wrong file.
  echo "Commit blocked. Fix what the gate named above, or re-run with:"
  echo "    git commit --no-verify"
  exit 1
fi
exit 0
