#!/usr/bin/env bash
# ─── ScanGrade pre-commit — template readability + Tailwind class names ──────
#
# Not installed by default: a hook lives in .git/, which is not committed, so
# every clone has to opt in once with
#
#     bash deploy/install-git-hooks.sh
#
# The same check is a hard gate in the VPS auto-deploy, so this is the early
# warning rather than the only defence: it fails the commit instead of the
# release.
#
# It runs only when a template or the stylesheet changed, so the common commit
# does not pay for it. `git commit --no-verify` skips it, which is Git's own
# escape hatch and is deliberate — a second, private bypass flag would be the
# thing that quietly stops this from ever running.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO" || exit 0

# What is actually being committed, not what happens to be on disk.
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

# tailwind.config.js and package.json are in this list because they change what
# the stylesheet build produces: a colour changed in the config, or a flag added
# to `css:build`, leaves the committed tailwind.css stale exactly the way a new
# template class does. The gate is only worth running when its subject moved.
#
# The SQL and the Python are in it for the schema contract, which answers two
# different questions from the same two directories: a `select` naming a column no
# file creates (PostgREST refuses it, the page renders empty) and a policy any
# caller can satisfy without a session (the anon key is public, so `USING (true)`
# on `exams` handed out answer keys). A commit that touches neither is judged by
# neither.
#
# `deploy/` is in it whole — every shell script and every Python file — because
# the check now includes the committed-secret scan, and the key that scan exists
# to catch was committed in `deploy/bootstrap.sh`. A filter that watched only the
# contract file there would have let the very commit that leaked a service-role
# key through the hook that was meant to warn about it.
if ! printf '%s\n' "$CHANGED" | grep -qE '^app/templates/.*\.html$|^app/static/css/|^tailwind\.config\.js$|^package\.json$|^app/.*\.py$|^supabase/.*\.sql$|^deploy/.*\.(sh|py)$'; then
  exit 0
fi

# The check reads the working tree, so a partially staged file is judged by what
# is on disk rather than by the hunk in the index. Staging the whole file — which
# is what `git add <file>` and every editor integration does — makes the two the
# same. Splitting a file across commits is the one case where this can disagree,
# and it errs toward blocking, never toward letting unreadable text through.
echo "theme gate: template or stylesheet changes staged — checking readability, class names and the cached stylesheet…"

# Git exports its own repository-selection variables to this hook. Measured: a
# linked worktree hands the hook an ABSOLUTE `GIT_DIR` and `GIT_INDEX_FILE`
# (`…/.git/worktrees/<name>/index`), and a plain checkout at least sets
# `GIT_INDEX_FILE`. Every `git` the gate spawns then inherits them and resolves
# THAT repository instead of the scratch one in its own working directory — so
# `test_static_tree`'s `git add` wrote its fixtures into this checkout's index,
# and the tree it had just dirtied failed the very gate that ran it. Clear them
# for the gate and everything it spawns; the gate's own `git` calls rediscover
# this checkout from their cwd, which is the same index.
#
# This sits after the `git diff --cached` above on purpose: that line reads the
# index git handed us, and is the one place the hook's own view must be kept.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
if ! bash "$REPO/deploy/theme_gate.sh"; then
  echo
  # Not "fix the contrast": the gate refuses more than one thing (an unreadable
  # colour, a class name built at render time, a stale stylesheet, a language the
  # page does not declare, and — exit 3 — a commit that removed a check itself).
  # Naming one cause here sends the author to the wrong file.
  echo "Commit blocked. Fix what the gate named above, or re-run with:"
  echo "    git commit --no-verify"
  exit 1
fi
exit 0
