[Unit]
Description=ScanGrade Flask Application
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=scangrade
Group=scangrade
WorkingDirectory=/opt/scangrade
EnvironmentFile=/opt/scangrade/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/scangrade/.venv/bin/gunicorn wsgi:app -c gunicorn.conf.py
Restart=always
RestartSec=5

# Rate limiting
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
