# ============================================
# ScanGrade - Environment Variables
# WAJIB: Jangan commit file .env ke GitHub!
# Copy file ini ke .env dan isi nilai sebenarnya
# ============================================

# Supabase (dapatkan dari dashboard.supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Untuk frontend JS
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # HANYA backend Flask!

# Flask
FLASK_SECRET_KEY=ubah-ini-untuk-produksi-min-32-karakter
FLASK_ENV=development  # production untuk deploy
FLASK_DEBUG=1  # 0 untuk production

# Ngrok (auto-filled oleh start-dev.sh)
NGROK_URL=

# Optional: Notification Services
FONNTE_TOKEN=  # WhatsApp gateway
RESEND_API_KEY=  # Email service
MIDTRANS_SERVER_KEY=  # Payment gateway
MIDTRANS_CLIENT_KEY=

# Celery (jika pakai async tasks)
REDIS_URL=redis://localhost:6379/0
