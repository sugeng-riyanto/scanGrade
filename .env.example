[TEMPLATE]
# ============================================
# ScanGrade - Environment Variables
# WAJIB: Jangan commit file .env ke GitHub!
# Copy file ini ke .env dan isi nilai sebenarnya
# ============================================

# Supabase (dapatkan dari dashboard.supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Untuk frontend JS
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # HANYA backend Flask!
# URL pooler mode-session (dashboard Supabase -> Project Settings -> Database).
# Dipakai migrasi DAN gerbang schema auto-deploy; tanpa ini gerbang schema tidak
# bisa memverifikasi rilis, dan kotak yang tidak bisa memeriksa rilis tidak mendeploy.
DIRECT_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Flask
FLASK_SECRET_KEY=ubah-ini-untuk-produksi-min-32-karakter
FLASK_ENV=development  # production untuk deploy
APP_URL=http://localhost:5000

# Sentry (error tracking — opsional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
APP_VERSION=1.0.0

# Ngrok (auto-filled oleh start-dev.sh)
NGROK_DOMAIN=

# Midtrans (payment gateway — opsional)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional: Notification Services
FONNTE_API_KEY=  # WhatsApp gateway
SMTP_EMAIL=scangrade9@gmail.com  # Gmail untuk reset password & notifikasi
SMTP_PASSWORD=  # Gmail app password (16 karakter)
# Nama lain untuk app password yang SAMA — isi salah satu saja. Aplikasi membaca
# keduanya; kalau kodenya tertulis `app_password_gmail` (atau `APP_PASSWORD_GMAIL`)
# dan SMTP_PASSWORD dibiarkan kosong/terkomentar, mail tetap bisa dikirim. Untuk
# dua nama ini spasinya dibuang, sebab Google menampilkan kodenya dalam empat
# kelompok (`abcd efgh ijkl mnop`) dan bentuk berspasi itu ditolak sebagai kredensial.
APP_PASSWORD_GMAIL=
RESEND_API_KEY=  # Email service

# Celery (jika pakai async tasks)
REDIS_URL=redis://localhost:6379/0
