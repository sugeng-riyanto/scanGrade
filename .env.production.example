# ============================================
# ScanGrade - Production Environment
# Copy ke .env dan isi nilai sebenarnya
# ============================================

# Supabase (PRODUCTION - ganti dengan project real)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=eyJ...  # Anon key dari project production
SUPABASE_SERVICE_KEY=eyJ...  # Service key dari project production

# Flask
FLASK_SECRET_KEY=ubah-ini-untuk-produksi-min-32-karakter
FLASK_ENV=production
FLASK_DEBUG=0

# REDIS (wajib untuk production multi-worker)
REDIS_URL=redis://localhost:6379/0
