# ============================================
# ScanGrade - Production Environment
# Copy ke /opt/scangrade/.env
# ============================================

# ── Supabase (PRODUCTION) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── Flask ──
FLASK_SECRET_KEY=ubah-ini-untuk-produksi-min-32-karakter
FLASK_ENV=production
FLASK_DEBUG=0

# ── Redis (wajib untuk multi-worker rate limiter) ──
REDIS_URL=redis://localhost:6379/0

# ── Midtrans (opsional — untuk subscription payment) ──
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_IS_PRODUCTION=false

# ── WhatsApp Gateway (opsional — untuk notifikasi) ──
# Format: https://your-fonnte-server.com/api
WA_API_URL=
WA_API_KEY=

# ── AI Grading Default (opsional — bisa diset per-teacher) ──
# AI_DEFAULT_PROVIDER=gemini
# AI_DEFAULT_KEY=

# ── Logging ──
LOG_LEVEL=INFO
